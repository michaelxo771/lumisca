<section class="section">
  <div class="container">
    <h2 class="section-title" style="text-align:center;">{{ section.settings.heading }}</h2>
    {% if section.settings.subheading != blank %}
      <p class="section-subtitle" style="text-align:center;max-width:600px;margin:12px auto 0;">{{ section.settings.subheading }}</p>
    {% endif %}
    <div class="grid grid-3" style="margin-top:48px;position:relative;">
      {% for block in section.blocks %}
        <div style="text-align:center;padding:32px 24px;" data-animate {{ block.shopify_attributes }}>
          <div style="width:64px;height:64px;background:var(--color-red);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;font-family:var(--font-heading);font-size:1.5rem;font-weight:700;color:white;">{{ forloop.index }}</div>
          {% if block.settings.icon != blank %}
            <div style="font-size:2rem;margin-bottom:12px;">{{ block.settings.icon }}</div>
          {% endif %}
          <h3 style="margin-bottom:12px;">{{ block.settings.title }}</h3>
          <p>{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Results In 3 Simple Steps" },
    { "type": "text", "id": "subheading", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Step title" },
        { "type": "textarea", "id": "description", "label": "Step description" },
        { "type": "text", "id": "icon", "label": "Emoji icon (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works",
      "blocks": [
        { "type": "step", "settings": { "title": "Choose Your Device", "icon": "💡", "description": "Select the Lumisca device that targets your concern — hair, skin or sleep." } },
        { "type": "step", "settings": { "title": "Use Daily For 20–25 Mins", "icon": "⏱️", "description": "Hands-free sessions that fit around your life. No clinic appointments needed." } },
        { "type": "step", "settings": { "title": "See Visible Results", "icon": "✨", "description": "Most customers notice real changes from week 4 onwards with consistent use." } }
      ]
    }
  ]
}
{% endschema %}
