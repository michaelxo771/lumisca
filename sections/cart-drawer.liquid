<div class="cart-drawer" id="cart-drawer" aria-hidden="true">
  <div class="cart-drawer-inner">
    <div class="cart-drawer-header">
      <h3>Your Cart (<span data-cart-count>{{ cart.item_count }}</span>)</h3>
      <button class="cart-drawer-close" id="cart-drawer-close" aria-label="Close cart">
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <div class="shipping-progress" style="padding:12px 20px;background:var(--color-light);border-bottom:1px solid var(--color-border);">
      <p id="shipping-progress-msg" style="font-size:0.85rem;margin-bottom:8px;color:var(--color-text);">
        {% assign threshold = settings.free_shipping_threshold | default: 5000 %}
        {% if cart.total_price >= threshold %}
          🎉 You've unlocked free UK delivery!
        {% else %}
          {% assign remaining = threshold | minus: cart.total_price %}
          Spend {{ remaining | money }} more for free UK delivery
        {% endif %}
      </p>
      <div style="background:var(--color-border);border-radius:99px;height:6px;overflow:hidden;">
        <div id="shipping-progress-fill" style="background:var(--color-red);height:100%;border-radius:99px;width:{{ cart.total_price | times: 100 | divided_by: threshold | at_most: 100 }}%;transition:width 0.4s ease;"></div>
      </div>
    </div>

    <div class="cart-drawer-items" id="cart-drawer-items">
      {% if cart.item_count == 0 %}
        <div class="cart-empty" style="text-align:center;padding:48px 20px;">
          <p style="margin-bottom:24px;color:var(--color-grey-mid);">Your cart is empty</p>
          <a href="/collections/all" class="btn btn-primary">Shop Now</a>
        </div>
      {% else %}
        {% for item in cart.items %}
          <div class="cart-item" data-key="{{ item.key }}">
            <img src="{{ item.image | image_url: width: 80 }}" alt="{{ item.title | escape }}" width="80" height="80" loading="lazy" style="border-radius:var(--radius-sm);object-fit:cover;">
            <div class="cart-item__info">
              <p class="cart-item__title">{{ item.product_title }}</p>
              {% if item.variant_title and item.variant_title != 'Default Title' %}
                <p style="font-size:0.8rem;color:var(--color-grey-mid);">{{ item.variant_title }}</p>
              {% endif %}
              <p class="cart-item__price">{{ item.final_line_price | money }}</p>
              <div class="cart-item__qty">
                <button class="qty-btn" data-action="decrease" data-key="{{ item.key }}" aria-label="Decrease quantity">−</button>
                <span class="qty-val">{{ item.quantity }}</span>
                <button class="qty-btn" data-action="increase" data-key="{{ item.key }}" aria-label="Increase quantity">+</button>
              </div>
            </div>
            <button class="cart-item__remove" data-key="{{ item.key }}" aria-label="Remove {{ item.title | escape }}">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    {% if cart.item_count > 0 %}
      <div class="cart-drawer-footer">
        <div class="cart-subtotal" style="display:flex;justify-content:space-between;font-weight:600;margin-bottom:8px;">
          <span>Subtotal</span>
          <span id="cart-subtotal">{{ cart.total_price | money }}</span>
        </div>
        <p style="font-size:0.8rem;color:var(--color-grey-mid);margin-bottom:16px;">Taxes and shipping calculated at checkout</p>
        <a href="/checkout" class="btn btn-primary btn-full">Checkout — {{ cart.total_price | money }}</a>
        <a href="/cart" class="btn btn-secondary btn-full" style="margin-top:8px;">View Full Cart</a>
        <div style="display:flex;justify-content:center;gap:8px;margin-top:16px;opacity:0.5;">
          <svg width="32" height="20" viewBox="0 0 38 24" aria-label="Visa"><rect width="38" height="24" rx="4" fill="#1A1F71"/><text x="19" y="17" text-anchor="middle" fill="white" font-size="11" font-family="sans-serif" font-weight="bold">VISA</text></svg>
          <svg width="32" height="20" viewBox="0 0 38 24" aria-label="Mastercard"><rect width="38" height="24" rx="4" fill="#252525"/><circle cx="14" cy="12" r="8" fill="#EB001B"/><circle cx="24" cy="12" r="8" fill="#F79E1B"/></svg>
          <svg width="32" height="20" viewBox="0 0 38 24" aria-label="PayPal"><rect width="38" height="24" rx="4" fill="#F5F7FA"/><text x="19" y="17" text-anchor="middle" fill="#003087" font-size="9" font-family="sans-serif" font-weight="bold">PayPal</text></svg>
          <svg width="32" height="20" viewBox="0 0 38 24" aria-label="Klarna"><rect width="38" height="24" rx="4" fill="#FFB3C7"/><text x="19" y="17" text-anchor="middle" fill="#17120E" font-size="10" font-family="sans-serif" font-weight="bold">klarna</text></svg>
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{"name":"Cart Drawer","settings":[]}
{% endschema %}
