<section style="padding:80px 0;">
  <div class="container" style="max-width:700px;">
    <h1 style="margin-bottom:16px;">We're Here To Help</h1>
    <p style="color:var(--color-grey-mid);margin-bottom:48px;">We respond to all enquiries within 24 hours, Monday to Friday.</p>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;margin-bottom:64px;">
      <div>
        {% form 'contact' %}
          {% if form.posted_successfully? %}
            <div style="background:#d4edda;border:1px solid #c3e6cb;padding:16px;border-radius:8px;margin-bottom:24px;">
              <p style="color:#155724;font-weight:600;">✓ Message sent! We'll reply within 24 hours.</p>
            </div>
          {% endif %}

          {% if form.errors %}
            <div style="background:#f8d7da;border:1px solid #f5c6cb;padding:16px;border-radius:8px;margin-bottom:24px;">
              <p style="color:#721c24;font-weight:600;">Please check the form below and try again.</p>
            </div>
          {% endif %}

          <div class="field">
            <label for="contact-name">Your Name</label>
            <input type="text" id="contact-name" name="contact[name]" placeholder="Sarah Johnson" value="{{ form.name }}" required autocomplete="name">
          </div>
          <div class="field">
            <label for="contact-email">Email Address</label>
            <input type="email" id="contact-email" name="contact[email]" placeholder="sarah@email.com" value="{{ form.email }}" required autocomplete="email">
          </div>
          <div class="field">
            <label for="contact-order">Order Number (optional)</label>
            <input type="text" id="contact-order" name="contact[order_number]" placeholder="#LUM1234">
          </div>
          <div class="field">
            <label for="contact-subject">Subject</label>
            <select id="contact-subject" name="contact[subject]">
              <option>Order enquiry</option>
              <option>Returns &amp; refunds</option>
              <option>Product question</option>
              <option>Delivery query</option>
              <option>Other</option>
            </select>
          </div>
          <div class="field">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="contact[body]" rows="5" placeholder="How can we help?" required>{{ form.body }}</textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-full">Send Message</button>
        {% endform %}
      </div>

      <div>
        <div style="background:#f5f3f0;border-radius:16px;padding:32px;margin-bottom:24px;">
          <h3 style="margin-bottom:16px;">Contact Details</h3>
          <p style="margin-bottom:8px;">📧 <strong><a href="mailto:support@lumisca.com" style="color:var(--color-red);">support@lumisca.com</a></strong></p>
          <p style="margin-bottom:8px;">⏰ Mon–Fri, 9am–5pm GMT</p>
          <p style="color:var(--color-grey-mid);font-size:0.9rem;margin-top:16px;">We aim to respond to all enquiries within 24 hours on business days.</p>
        </div>
        <div style="background:#f5f3f0;border-radius:16px;padding:32px;">
          <h3 style="margin-bottom:16px;">Quick Answers</h3>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:10px;">
            <li><a href="/pages/faq" style="color:var(--color-red);font-weight:500;">→ Delivery information</a></li>
            <li><a href="/pages/faq" style="color:var(--color-red);font-weight:500;">→ Returns &amp; refunds</a></li>
            <li><a href="/pages/faq" style="color:var(--color-red);font-weight:500;">→ When will I see results?</a></li>
            <li><a href="/pages/science" style="color:var(--color-red);font-weight:500;">→ The science behind Lumisca</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{"name":"Contact Page","settings":[]}
{% endschema %}
