<section class="section" style="background:var(--color-black);color:white;text-align:center;">
  <div class="container">
    <h2 style="color:white;margin-bottom:12px;">{{ section.settings.heading }}</h2>
    <p style="color:rgba(249,247,244,0.6);margin-bottom:48px;">{{ section.settings.subheading }}</p>
    <div class="grid grid-3" style="margin-bottom:48px;">
      {% for block in section.blocks %}
        <div style="aspect-ratio:1;border-radius:12px;overflow:hidden;position:relative;" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.alt_text, style: 'width:100%;height:100%;object-fit:cover;' }}
          {% else %}
            <div style="width:100%;height:100%;background:rgba(255,255,255,0.05);border:1px dashed rgba(255,255,255,0.2);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;">
              <svg width="32" height="32" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="1.5" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
              <p style="color:rgba(255,255,255,0.3);font-size:0.75rem;">Add UGC image</p>
            </div>
          {% endif %}
        </div>
      {% else %}
        {% for i in (1..6) %}
          <div style="aspect-ratio:1;background:rgba(255,255,255,0.05);border-radius:12px;border:1px dashed rgba(255,255,255,0.2);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;">
            <svg width="32" height="32" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="1.5" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
            <p style="color:rgba(255,255,255,0.3);font-size:0.75rem;">UGC Image {{ i }}</p>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
    <div style="display:flex;justify-content:center;gap:16px;flex-wrap:wrap;">
      <a href="{{ section.settings.tiktok_url | default: settings.tiktok_url }}" class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
        <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" style="margin-right:8px;"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg>
        {{ section.settings.cta_text }}
      </a>
      {% if section.settings.instagram_url != blank or settings.instagram_url != blank %}
        <a href="{{ section.settings.instagram_url | default: settings.instagram_url }}" class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-right:8px;"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          Follow on Instagram
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UGC Strip",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join The Lumisca Community" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Tag us @lumisca for a chance to be featured" },
    { "type": "text", "id": "cta_text", "label": "TikTok CTA text", "default": "Follow @lumisca On TikTok" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL (overrides global setting)" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "UGC Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt_text", "label": "Alt text" }
      ]
    }
  ],
  "presets": [{ "name": "UGC Strip" }]
}
{% endschema %}
