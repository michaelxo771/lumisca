<section style="background:#0A0A0A;color:#F9F7F4;padding:80px 0;">
  <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;min-height:70vh;">
      <div>
        {% if section.settings.badge != blank %}
          <div style="display:inline-block;background:rgba(200,16,46,0.15);color:#C8102E;border:1px solid rgba(200,16,46,0.3);padding:6px 16px;border-radius:99px;font-size:0.8rem;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;margin-bottom:24px;">{{ section.settings.badge }}</div>
        {% endif %}
        <h1 style="font-family:'Playfair Display',Georgia,serif;font-size:clamp(2rem,4vw,3.5rem);font-weight:700;color:#F9F7F4;line-height:1.15;margin-bottom:24px;">{{ section.settings.heading }}</h1>
        <p style="font-size:1.15rem;color:rgba(249,247,244,0.75);line-height:1.7;margin-bottom:40px;">{{ section.settings.subheading }}</p>
        <div style="display:flex;gap:16px;flex-wrap:wrap;margin-bottom:48px;">
          {% if section.settings.cta_text != blank %}
            <a href="{{ section.settings.cta_url | default: '/collections/all' }}" style="display:inline-flex;align-items:center;justify-content:center;padding:16px 32px;background:#C8102E;color:#fff;font-family:'DM Sans',sans-serif;font-size:1rem;font-weight:600;border-radius:8px;text-decoration:none;border:2px solid #C8102E;">{{ section.settings.cta_text }}</a>
          {% endif %}
          {% if section.settings.cta2_text != blank %}
            <a href="{{ section.settings.cta2_url | default: '/pages/science' }}" style="display:inline-flex;align-items:center;justify-content:center;padding:16px 32px;background:transparent;color:#F9F7F4;font-family:'DM Sans',sans-serif;font-size:1rem;font-weight:600;border-radius:8px;text-decoration:none;border:2px solid #F9F7F4;">{{ section.settings.cta2_text }}</a>
          {% endif %}
        </div>
        <div style="display:flex;gap:40px;flex-wrap:wrap;">
          <div><strong style="display:block;font-family:'Playfair Display',Georgia,serif;font-size:1.75rem;font-weight:700;color:#F9F7F4;line-height:1;">10,000+</strong><span style="font-size:0.85rem;color:rgba(249,247,244,0.6);">Happy Customers</span></div>
          <div><strong style="display:block;font-family:'Playfair Display',Georgia,serif;font-size:1.75rem;font-weight:700;color:#F9F7F4;line-height:1;">4.9★</strong><span style="font-size:0.85rem;color:rgba(249,247,244,0.6);">Average Rating</span></div>
          <div><strong style="display:block;font-family:'Playfair Display',Georgia,serif;font-size:1.75rem;font-weight:700;color:#F9F7F4;line-height:1;">60-Day</strong><span style="font-size:0.85rem;color:rgba(249,247,244,0.6);">Money Back</span></div>
        </div>
      </div>
      <div style="display:flex;justify-content:center;align-items:center;">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 600 | image_tag: loading: 'eager', alt: section.settings.heading, style: 'border-radius:16px;max-width:520px;width:100%;' }}
        {% else %}
          <div style="width:100%;max-width:480px;aspect-ratio:1;background:rgba(200,16,46,0.08);border-radius:16px;display:flex;align-items:center;justify-content:center;border:2px dashed rgba(200,16,46,0.25);"><p style="color:rgba(249,247,244,0.4);font-size:0.9rem;text-align:center;padding:24px;">Add hero image<br>in theme editor</p></div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge text", "default": "🔴 As Seen On TikTok" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your At-Home Light Therapy Clinic." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Clinically studied wavelengths. Professional results. From your sofa." },
    { "type": "text", "id": "cta_text", "label": "Primary button text", "default": "Shop The Collection" },
    { "type": "url", "id": "cta_url", "label": "Primary button URL" },
    { "type": "text", "id": "cta2_text", "label": "Secondary button text", "default": "See The Science" },
    { "type": "url", "id": "cta2_url", "label": "Secondary button URL" },
    { "type": "image_picker", "id": "image", "label": "Hero image" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
