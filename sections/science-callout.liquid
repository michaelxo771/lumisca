<section class="section" style="background:var(--color-black);color:var(--color-white);">
  <div class="container">
    <h2 class="section-title" style="color:white;text-align:center;">{{ section.settings.heading }}</h2>
    <p class="section-subtitle" style="color:rgba(249,247,244,0.7);text-align:center;max-width:640px;margin:12px auto 0;">{{ section.settings.subheading }}</p>
    <div class="grid grid-3" style="margin:48px 0;">
      {% for block in section.blocks %}
        <div style="text-align:center;padding:32px;background:rgba(255,255,255,0.05);border-radius:16px;border:1px solid rgba(201,168,76,0.3);" data-animate {{ block.shopify_attributes }}>
          <div style="font-size:2.5rem;font-weight:700;color:var(--color-gold);font-family:var(--font-heading);margin-bottom:8px;">{{ block.settings.stat }}</div>
          <p style="color:rgba(249,247,244,0.7);font-size:0.95rem;">{{ block.settings.description }}</p>
          {% if block.settings.source != blank %}
            <p style="color:rgba(249,247,244,0.4);font-size:0.75rem;margin-top:8px;font-style:italic;">{{ block.settings.source }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    {% if section.settings.disclaimer != blank %}
      <p style="color:rgba(249,247,244,0.4);font-size:0.8rem;text-align:center;margin-bottom:32px;font-style:italic;">{{ section.settings.disclaimer }}</p>
    {% endif %}
    <div style="text-align:center;">
      <a href="{{ section.settings.cta_url }}" class="btn btn-ghost">{{ section.settings.cta_text }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Science Callout",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Science Behind Lumisca" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Clinically studied wavelengths that work at a cellular level." },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Read The Full Science" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer text (optional)", "default": "* Based on published independent research studies. Individual results may vary." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "stat", "label": "Stat / number" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "source", "label": "Source reference (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Science Callout",
      "blocks": [
        { "type": "stat", "settings": { "stat": "650nm", "description": "Red light wavelength clinically studied for hair follicle stimulation and regrowth", "source": "Photomedicine & Laser Surgery, 2014" } },
        { "type": "stat", "settings": { "stat": "31%", "description": "Increase in collagen production observed in red light therapy research studies", "source": "Seminars in Cutaneous Medicine, 2013" } },
        { "type": "stat", "settings": { "stat": "92%", "description": "Of users report improved sleep quality within 2 weeks of consistent use", "source": "Internal customer survey, 2024" } }
      ]
    }
  ]
}
{% endschema %}
