        <div style="display:flex;gap:16px;">
          <a href="{{ settings.tiktok_url }}" aria-label="TikTok" style="opacity:0.6;transition:var(--transition);">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg>
          </a>
          <a href="{{ settings.instagram_url }}" aria-label="Instagram" style="opacity:0.6;transition:var(--transition);">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        </div>
      </div>
      <div>
        <p class="footer-heading">Shop</p>
        <ul class="footer-links">
          <li><a href="/collections/all">All Products</a></li>
          <li><a href="/products/lumisca-pro-hair-growth-cap">Hair Growth Cap</a></li>
          <li><a href="/products/lumisca-glow-face-mask">Face Mask</a></li>
          <li><a href="/products/lumisca-rest-eye-mask">Eye Mask</a></li>
          <li><a href="/products/lumisca-complete-bundle">Complete Bundle</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-heading">Info</p>
        <ul class="footer-links">
          <li><a href="/pages/about">About Us</a></li>
          <li><a href="/pages/science">The Science</a></li>
          <li><a href="/pages/reviews">Reviews</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-heading">Support</p>
        <ul class="footer-links">
          <li><a href="/pages/shipping">Shipping Policy</a></li>
          <li><a href="/pages/returns">Returns Policy</a></li>
          <li><a href="/pages/privacy">Privacy Policy</a></li>
          <li><a href="/pages/terms">Terms of Service</a></li>
          <li><a href="/pages/tracking">Track My Order</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>{{ settings.footer_copyright | default: '© 2026 Lumisca. All rights reserved.' }}</p>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <img src="{{ 'visa.svg' | asset_url }}" alt="Visa" width="38" height="24" loading="lazy">
        <img src="{{ 'mastercard.svg' | asset_url }}" alt="Mastercard" width="38" height="24" loading="lazy">
        <img src="{{ 'paypal.svg' | asset_url }}" alt="PayPal" width="38" height="24" loading="lazy">
        <img src="{{ 'klarna.svg' | asset_url }}" alt="Klarna" width="38" height="24" loading="lazy">
        <img src="{{ 'apple-pay.svg' | asset_url }}" alt="Apple Pay" width="38" height="24" loading="lazy">
      </div>
