<section class="section" style="background:#f5f3f0;">
  <div class="container">
    <h2 class="section-title" style="text-align:center;">{{ section.settings.heading }}</h2>
    <div style="text-align:center;margin-bottom:48px;">
      <div class="stars" style="justify-content:center;font-size:1.5rem;margin-bottom:8px;color:#f5a623;">★★★★★</div>
      <p style="font-weight:600;">{{ section.settings.rating_text }}</p>
    </div>
    <div class="grid grid-3">
      {% for block in section.blocks %}
        <div style="background:white;padding:32px;border-radius:16px;box-shadow:var(--shadow-sm);" data-animate {{ block.shopify_attributes }}>
          <div style="color:#f5a623;font-size:1.1rem;margin-bottom:12px;letter-spacing:2px;">★★★★★</div>
          {% if block.settings.headline != blank %}
            <p style="font-weight:700;margin-bottom:8px;font-size:0.95rem;">{{ block.settings.headline }}</p>
          {% endif %}
          <p style="margin-bottom:20px;font-style:italic;color:var(--color-grey-mid);line-height:1.7;">"{{ block.settings.review }}"</p>
          <div style="display:flex;align-items:center;gap:12px;">
            <div style="width:40px;height:40px;background:var(--color-red);border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-weight:700;flex-shrink:0;">{{ block.settings.name | slice: 0 }}</div>
            <div>
              <p style="font-weight:600;font-size:0.9rem;margin-bottom:2px;">{{ block.settings.name }}</p>
              <p style="font-size:0.8rem;color:var(--color-grey-mid);">{{ block.settings.location }} &middot; {{ block.settings.product }}</p>
            </div>
            {% if block.settings.verified %}
              <span style="margin-left:auto;font-size:0.75rem;color:#2e7d32;font-weight:600;">✓ Verified</span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Customers Are Saying" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.9/5 from 2,847 verified reviews" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "headline", "label": "Review headline (optional)" },
        { "type": "textarea", "id": "review", "label": "Review text" },
        { "type": "text", "id": "name", "label": "Customer name" },
        { "type": "text", "id": "location", "label": "Location" },
        { "type": "text", "id": "product", "label": "Product purchased" },
        { "type": "checkbox", "id": "verified", "label": "Show verified badge", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "review", "settings": { "headline": "My hairdresser noticed before I did!", "review": "I've been losing my hair since menopause and tried everything. 10 weeks with the Lumisca cap and I genuinely can't believe the difference. My hairdresser noticed before I even told her.", "name": "Sarah M.", "location": "Manchester", "product": "Hair Growth Cap", "verified": true } },
        { "type": "review", "settings": { "headline": "Paid for itself in the first month", "review": "I was spending £80 a month on facials. This paid for itself in the first month. My skin looks genuinely brighter and the fine lines around my eyes have visibly softened after 6 weeks.", "name": "Claire B.", "location": "Edinburgh", "product": "Face Mask", "verified": true } },
        { "type": "review", "settings": { "headline": "Sleep better than I have in years", "review": "Work in front of screens 10 hours a day and the eye strain was becoming a real problem. 15 minutes before bed and I sleep better than I have in years. Brilliant product.", "name": "James T.", "location": "Birmingham", "product": "Eye Mask", "verified": true } },
        { "type": "review", "settings": { "headline": "Use all three products every day", "review": "Bought the full bundle and I use all three products every single day. The hair cap is showing real results at week 8, my skin is glowing and I haven't had a bad night's sleep since.", "name": "Emma R.", "location": "Dublin", "product": "Complete Bundle", "verified": true } },
        { "type": "review", "settings": { "headline": "New growth at the temples by month 4", "review": "Started using this in January for my receding hairline. It's now April and there's definitely new growth coming through at the temples. My wife is now stealing it for her thinning crown.", "name": "David K.", "location": "Leeds", "product": "Hair Growth Cap", "verified": true } },
        { "type": "review", "settings": { "headline": "Acne scarring faded significantly", "review": "Bought this for my acne scarring and the results shocked me. Used it every day for 8 weeks and the dark marks have faded significantly. My skin texture has completely changed.", "name": "Priya S.", "location": "London", "product": "Face Mask", "verified": true } }
      ]
    }
  ]
}
{% endschema %}
