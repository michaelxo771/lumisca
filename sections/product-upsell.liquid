<section style="padding:60px 0;background:#f5f3f0;">
  <div class="container">
    <h2 class="section-title" style="text-align:center;">{{ section.settings.heading }}</h2>
    <p class="section-subtitle" style="text-align:center;max-width:600px;margin:12px auto 0;">{{ section.settings.subheading }}</p>
    <div class="grid grid-3" style="margin-top:48px;">
      {% for block in section.blocks %}
        {% assign upsell_product = all_products[block.settings.product] %}
        <div class="product-card" style="border-radius:16px;overflow:hidden;background:white;box-shadow:var(--shadow-sm);{% if block.settings.featured %}border:2px solid var(--color-red);{% endif %}" data-animate {{ block.shopify_attributes }}>
          {% if block.settings.featured %}
            <div style="background:var(--color-red);color:white;text-align:center;padding:8px;font-size:0.85rem;font-weight:600;">⭐ Best Value — Save £174.98</div>
          {% endif %}
          <div class="product-card-image" style="overflow:hidden;">
            {% if upsell_product.featured_image %}
              {{ upsell_product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: upsell_product.title, style: 'width:100%;aspect-ratio:1;object-fit:cover;' }}
            {% else %}
              <div style="width:100%;aspect-ratio:1;background:var(--color-grey-light);display:flex;align-items:center;justify-content:center;">
                <p style="color:var(--color-grey-mid);font-size:0.8rem;">No image</p>
              </div>
            {% endif %}
          </div>
          <div class="product-card-body" style="padding:20px;">
            <h3 style="font-size:1rem;font-weight:600;margin-bottom:6px;">{{ upsell_product.title }}</h3>
            {% if block.settings.benefit != blank %}
              <p style="font-size:0.9rem;color:var(--color-grey-mid);margin-bottom:12px;">{{ block.settings.benefit }}</p>
            {% endif %}
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
              <span style="font-size:1.15rem;font-weight:700;color:var(--color-black);">{{ upsell_product.price | money }}</span>
              {% if upsell_product.compare_at_price > upsell_product.price %}
                <span style="text-decoration:line-through;color:var(--color-grey-mid);font-size:0.9rem;">{{ upsell_product.compare_at_price | money }}</span>
              {% endif %}
            </div>
            <a href="{{ upsell_product.url }}" class="btn {% if block.settings.featured %}btn-primary{% else %}btn-secondary{% endif %} btn-full">
              {% if block.settings.featured %}Shop Bundle{% else %}View Product{% endif %}
            </a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Upsell",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete Your Lumisca Routine" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Pair your device with the rest of the collection" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Upsell Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "benefit", "label": "Benefit text" },
        { "type": "checkbox", "id": "featured", "label": "Featured (bundle highlight)", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Product Upsell" }]
}
{% endschema %}
