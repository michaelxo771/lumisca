<section class="section">
  <div class="container">
    <h2 class="section-title">{{ section.settings.heading }}</h2>
    <p class="section-subtitle">{{ section.settings.subheading }}</p>
    <div class="grid grid-4">
      {% for block in section.blocks %}
        {% assign product = all_products[block.settings.product] %}
        <div class="product-card" {{ block.shopify_attributes }}>
          <div class="product-card-image">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: product.title }}
            {% else %}
              <div style="width:100%;height:280px;background:var(--color-grey-light);display:flex;align-items:center;justify-content:center;"><p style="color:var(--color-grey-mid);font-size:0.8rem;">Add product image</p></div>
            {% endif %}
          </div>
          <div class="product-card-body">
            {% if block.settings.badge != blank %}
              <div class="badge badge-gold" style="margin-bottom:8px;">{{ block.settings.badge }}</div>
            {% endif %}
            <h3 class="product-card-title">{{ product.title }}</h3>
            <p class="product-card-benefit">{{ block.settings.benefit }}</p>
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:12px;">
              <div class="stars">★★★★★</div>
              <span class="review-count" style="font-size:0.85rem;color:var(--color-grey-mid);">4.9 ({{ block.settings.review_count }})</span>
            </div>
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
              <span class="price" style="font-size:1.2rem;font-weight:700;color:var(--color-black);">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="price-compare" style="text-decoration:line-through;color:var(--color-grey-mid);font-size:0.95rem;">{{ product.compare_at_price | money }}</span>
                <span class="price-save" style="background:var(--color-red);color:white;font-size:0.75rem;font-weight:600;padding:2px 8px;border-radius:4px;">Save {{ product.compare_at_price | minus: product.price | money }}</span>
              {% endif %}
            </div>
            <a href="{{ product.url }}" class="btn btn-primary btn-full">Shop Now</a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Lumisca Collection" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Clinically studied light therapy. Designed for real life." }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "benefit", "label": "One line benefit" },
        { "type": "text", "id": "badge", "label": "Badge (optional)" },
        { "type": "text", "id": "review_count", "label": "Review count", "default": "247" }
      ]
    }
  ],
  "presets": [{ "name": "Featured Products" }]
}
{% endschema %}
