<section style="padding:60px 0;">
  <div class="container">
    <h2 class="section-title" style="text-align:center;">{{ section.settings.heading }}</h2>
    {% if section.settings.subheading != blank %}
      <p class="section-subtitle" style="text-align:center;max-width:600px;margin:12px auto 0;">{{ section.settings.subheading }}</p>
    {% endif %}
    <div class="grid grid-3" style="margin-top:48px;">
      {% for block in section.blocks %}
        <div style="display:flex;gap:16px;align-items:start;padding:24px;background:#f5f3f0;border-radius:12px;" data-animate {{ block.shopify_attributes }}>
          <div style="width:48px;height:48px;background:var(--color-red);border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:1.5rem;">{{ block.settings.icon }}</div>
          <div>
            <p style="font-weight:700;margin-bottom:6px;color:var(--color-black);">{{ block.settings.title }}</p>
            <p style="font-size:0.9rem;color:var(--color-grey-mid);line-height:1.6;">{{ block.settings.description }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Benefits",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Lumisca Works" },
    { "type": "text", "id": "subheading", "label": "Subheading (optional)" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji icon" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "🔴", "title": "Clinically Studied Wavelengths", "description": "Our 650nm and 850nm dual wavelengths are the most studied in red light therapy research." } },
        { "type": "benefit", "settings": { "icon": "🙌", "title": "Hands-Free Design", "description": "Wear it while working, relaxing or watching TV — no holding required." } },
        { "type": "benefit", "settings": { "icon": "⏱️", "title": "25 Minute Auto Timer", "description": "Auto shut-off after each session means you never have to think about it." } },
        { "type": "benefit", "settings": { "icon": "🔋", "title": "Rechargeable Via USB-C", "description": "No cables during use. Charge between sessions and you're ready to go." } },
        { "type": "benefit", "settings": { "icon": "👥", "title": "For Men And Women", "description": "Suitable for all hair types, scalp conditions and skin tones." } },
        { "type": "benefit", "settings": { "icon": "📈", "title": "Results From Week 8", "description": "Most customers see visible improvement between weeks 8–12 with consistent use." } }
      ]
    }
  ]
}
{% endschema %}
