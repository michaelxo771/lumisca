<section id="reviews" style="padding:60px 0;">
  <div class="container">
    <h2 class="section-title" style="text-align:center;">{{ section.settings.heading }}</h2>
    <div style="text-align:center;margin-bottom:48px;">
      <div style="color:#f5a623;font-size:2rem;margin-bottom:8px;letter-spacing:4px;">★★★★★</div>
      <p style="font-size:1.5rem;font-weight:700;color:var(--color-black);">4.9 out of 5</p>
      <p style="color:var(--color-grey-mid);">Based on {{ section.settings.review_count }} verified reviews</p>
    </div>
    <div class="grid grid-2" style="gap:24px;">
      {% for block in section.blocks %}
        <div style="background:#f5f3f0;padding:28px;border-radius:16px;" data-animate {{ block.shopify_attributes }}>
          <div style="color:#f5a623;letter-spacing:2px;margin-bottom:8px;">★★★★★</div>
          {% if block.settings.title != blank %}
            <p style="font-weight:700;margin-bottom:8px;color:var(--color-black);">{{ block.settings.title }}</p>
          {% endif %}
          <p style="margin-bottom:16px;font-style:italic;color:var(--color-grey-mid);line-height:1.7;">"{{ block.settings.review }}"</p>
          <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
            <div style="display:flex;align-items:center;gap:10px;">
              <div style="width:36px;height:36px;background:var(--color-red);border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:0.9rem;flex-shrink:0;">{{ block.settings.name | slice: 0 }}</div>
              <div>
                <p style="font-weight:600;font-size:0.9rem;color:var(--color-black);">{{ block.settings.name }}</p>
                <p style="font-size:0.8rem;color:var(--color-grey-mid);">{{ block.settings.location }} &middot; <span style="color:#2e7d32;font-weight:600;">✓ Verified Purchase</span></p>
              </div>
            </div>
            {% if block.settings.weeks != blank %}
              <span style="font-size:0.78rem;background:rgba(200,16,46,0.08);color:var(--color-red);padding:4px 10px;border-radius:20px;font-weight:600;">{{ block.settings.weeks }}</span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
    <div style="text-align:center;margin-top:40px;">
      <a href="/pages/reviews" class="btn btn-secondary">See All {{ section.settings.review_count }} Reviews</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer Reviews" },
    { "type": "text", "id": "review_count", "label": "Total review count", "default": "247" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "title", "label": "Review title" },
        { "type": "textarea", "id": "review", "label": "Review text" },
        { "type": "text", "id": "name", "label": "Customer name" },
        { "type": "text", "id": "location", "label": "Location" },
        { "type": "text", "id": "weeks", "label": "Result timeframe (e.g. Results at week 8)", "info": "Shows as a badge on the review card" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Reviews",
      "blocks": [
        { "type": "review", "settings": { "title": "Life changing for my hair", "review": "I've been losing my hair since menopause and tried everything. 10 weeks with the Lumisca cap and I genuinely can't believe the difference. My hairdresser noticed before I even told her. Worth every penny.", "name": "Sarah M.", "location": "Manchester", "weeks": "Results at week 10" } },
        { "type": "review", "settings": { "title": "Finally seeing regrowth", "review": "Started using this in January for my receding hairline. It's now April and there's definitely new growth coming through at the temples. Reordering a second one for my wife.", "name": "David K.", "location": "Leeds", "weeks": "Results at week 12" } },
        { "type": "review", "settings": { "title": "Exceeded all expectations", "review": "I was sceptical but desperate. At week 8 my partner noticed my hair looked thicker before I said anything. That was the proof I needed. Absolutely recommend.", "name": "Michelle T.", "location": "Bristol", "weeks": "Results at week 8" } },
        { "type": "review", "settings": { "title": "Worth every penny", "review": "Tried minoxidil, biotin, everything. This is the only thing that has actually made a visible difference. Hair is noticeably thicker and I have baby hairs growing back at my hairline.", "name": "James R.", "location": "London", "weeks": "Results at week 9" } }
      ]
    }
  ]
}
{% endschema %}
