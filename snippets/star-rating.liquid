<div style="display:flex;align-items:center;gap:6px;">
  <div class="stars" style="color:#f5a623;letter-spacing:2px;font-size:{{ star_size | default: '1rem' }};">
    {% assign rating = rating | default: 4.9 %}
    {% assign rating_rounded = rating | times: 2 | round | divided_by: 2.0 %}
    {% assign full_stars = rating_rounded | floor %}
    {% assign half_star = rating_rounded | modulo: 1 | times: 2 | round %}
    {% for i in (1..5) %}
      {% if i <= full_stars %}★{% elsif i == full_stars | plus: 1 and half_star == 1 %}½{% else %}☆{% endif %}
    {% endfor %}
  </div>
  <span style="font-weight:700;font-size:0.9rem;color:var(--color-black);">{{ rating }}</span>
  {% if review_count %}
    <span class="review-count" style="font-size:0.85rem;color:var(--color-grey-mid);">({{ review_count }} reviews)</span>
  {% endif %}
</div>
