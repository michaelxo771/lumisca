<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0A0A0A">
  <title>{{ shop.name }} — Coming Soon</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  {{ 'lumisca.css' | asset_url | stylesheet_tag }}
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{background:#0A0A0A;color:#F9F7F4;font-family:'DM Sans',sans-serif;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:32px;}
    .pw-logo{font-family:'Playfair Display',serif;font-size:2.5rem;font-weight:700;letter-spacing:0.08em;color:#F9F7F4;margin-bottom:48px;}
    .pw-logo span{color:#C8102E;}
    h1{font-family:'Playfair Display',serif;font-size:clamp(1.8rem,4vw,3rem);font-weight:700;margin-bottom:16px;line-height:1.2;}
    p{color:rgba(249,247,244,0.7);margin-bottom:32px;font-size:1.1rem;max-width:500px;}
    .pw-form{display:flex;gap:12px;max-width:420px;width:100%;flex-wrap:wrap;justify-content:center;}
    .pw-form input[type="password"]{flex:1;min-width:200px;padding:14px 20px;border-radius:8px;border:1px solid rgba(249,247,244,0.2);background:rgba(249,247,244,0.05);color:#F9F7F4;font-family:'DM Sans',sans-serif;font-size:1rem;outline:none;}
    .pw-form input[type="password"]:focus{border-color:#C8102E;}
    .pw-form button{padding:14px 28px;background:#C8102E;color:#F9F7F4;border:none;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:1rem;font-weight:600;cursor:pointer;white-space:nowrap;}
    .pw-form button:hover{background:#a50d24;}
    .pw-error{color:#C8102E;margin-top:12px;font-size:0.9rem;}
    .pw-footer{margin-top:64px;color:rgba(249,247,244,0.4);font-size:0.85rem;}
    .pw-footer a{color:rgba(249,247,244,0.4);text-decoration:none;}
  </style>
</head>
<body>
  <div class="pw-logo">LUMI<span>S</span>CA</div>

  <h1>Something Exciting Is Coming</h1>
  <p>We're putting the finishing touches to the UK's home for professional-grade light therapy. Enter the password to get early access.</p>

  {% form 'storefront_password' %}
    {% if form.errors %}
      <div class="pw-error">Incorrect password. Please try again.</div>
    {% endif %}
    <div class="pw-form">
      <input
        type="password"
        name="password"
        id="password"
        placeholder="Enter password"
        autocomplete="current-password"
        autofocus
      >
      <button type="submit">Enter</button>
    </div>
  {% endform %}

  <div class="pw-footer">
    <p>Are you the store owner? <a href="/admin">Log in here</a></p>
  </div>
</body>
</html>
