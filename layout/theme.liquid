<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ page_title }} | {{ shop.name }}</title>
<meta name="description" content="{{ page_description | escape }}">
<link rel="canonical" href="{{ canonical_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
{{ content_for_header }}
{{ 'lumisca.css' | asset_url | stylesheet_tag }}
{{ 'lumisca-conversion.css' | asset_url | stylesheet_tag }}
</head>
<body>
{% section 'announcement-bar' %}
{% section 'header' %}
<main id="main-content">{{ content_for_layout }}</main>
{% render 'cart-drawer' %}
{% render 'welcome-popup' %}
{% render 'exit-popup' %}
{% render 'cart-upsell-popup' %}
{% render 'recent-purchase-toast' %}
{% render 'cookie-consent' %}
{{ 'lumisca.js' | asset_url | script_tag }}
{{ 'lumisca-conversion.js' | asset_url | script_tag }}
</body>
</html>
